# Spirrow-Prismind Configuration
# Copy this file to config.toml and customize

[google]
# Path to Google OAuth credentials file
credentials_path = "credentials.json"
# Path to store OAuth token
token_path = "token.json"
# Root folder ID for all projects (e.g., "Projects" folder in Google Drive)
projects_folder_id = ""

[services]
# Memory Server URL
memory_server_url = "http://localhost:8080"
# Memory Server protocol: "rest" (HTTP REST API) or "mcp" (MCP over SSE)
memory_server_type = "rest"
# RAG Server URL (ChromaDB compatible)
rag_server_url = "http://localhost:8000"
# RAG collection name
rag_collection = "prismind"

[documents]
# Where document bodies live.
#   "google"     - Google Drive/Docs (behaviour before Phase 1; rollback path)
#   "filesystem" - Markdown in the Git clones under `root`
backend = "google"
# Directory holding one Git clone per repository (filesystem backend only)
root = "/srv/docs"
# Repository map. Empty = <root>/repos.toml
repos_config = ""
# Working tier: documents still being written (design 6.3.1). Outside Git.
work_root = "/srv/docs-work"
# How long a draft may sit in the working tier before reconcile() flags it
stale_after_days = 14.0

[log]
# Log level: DEBUG, INFO, WARNING, ERROR
level = "INFO"
# Log file (empty = stdout)
file = ""
# Log format: text, json
format = "text"

[session]
# Auto-save interval (number of messages)
auto_save_interval = 20
# User name (shared across multiple PCs for session state identification)
user_name = ""

[rerank]
# Re-rank search_knowledge candidates with Lexora /v1/decide
# (T-decide-rerank). Off by default; when off, Lexora is never called.
enabled = false
# Lexora base URL (POST <lexora_url>/v1/decide). No TypeSafe SDK is used.
lexora_url = "http://localhost:8110"
# /v1/decide policy tag (filter Lexora's decision log by it)
policy = "prismind.rerank"
# Recorded verbatim in Lexora's decision log; bump when the questions change
questions_version = "prismind.rerank/v1"
# Candidates per request. The request always carries top_n questions
# (padded when fewer candidates exist) so questions_hash stays constant.
top_n = 30
# Re-ranked candidates handed on (also capped by the caller's limit)
keep_k = 8
# Characters of each candidate sent in state. top_n * this must be <= 30000.
max_chars_per_candidate = 600
# HTTP timeout for the /v1/decide call, seconds. On failure: search order.
timeout_s = 10
# has_answer below this returns no RAG candidates ("no match")
min_noul = 0.35
