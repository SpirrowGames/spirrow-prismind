#!/usr/bin/env bash
# .mindwire-gate — this repository's green predicate (exit 0 = green).
#
# Single source of truth: the commands below are the ones
# .github/workflows/ci.yml runs ("Install dependencies" + "Run tests").
# Do not add checks here that CI does not run, and do not drop any that
# it does — keep the two in step.
#
# CI runs on a fresh runner; to get the same isolation locally (and to
# avoid installing into whatever interpreter happens to be on PATH) the
# commands run inside a repo-local virtualenv at .venv/ (gitignored).
# Override the interpreter used to create it with MINDWIRE_GATE_PYTHON.
set -euo pipefail

cd "$(dirname "$0")"

PY_BOOT="${MINDWIRE_GATE_PYTHON:-python}"

if [ ! -d .venv ]; then
  "$PY_BOOT" -m venv .venv
fi

if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=.venv/Scripts/python   # Windows venv layout
fi

# --- ci.yml: Install dependencies ---
"$PY" -m pip install --upgrade pip
"$PY" -m pip install -e ".[dev]"

# --- ci.yml: Run tests ---
"$PY" -m pytest tests/ -v
